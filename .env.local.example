# Copiar a .env.local (gitignored) y completar con los valores reales
# del proyecto Supabase (Settings -> API Keys -> "anon" / "public").
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# Mismos valores -- usados por lib/supabase/browserClient.ts (favoritos
# por cuenta, cliente-side). Necesitan el prefijo NEXT_PUBLIC_ para
# llegar al bundle del navegador; es seguro, la RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
